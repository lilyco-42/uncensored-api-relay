{
  "claude": {
    "//": "cc-switch Claude provider -> Rust uncensored relay (Anthropic Messages protocol)",
    "env": {
      "ANTHROPIC_BASE_URL": "http://127.0.0.1:8080/v1",
      "ANTHROPIC_AUTH_TOKEN": "<上游无审查模型的 API Key>",
      "ANTHROPIC_MODEL": "uncensored-27b",
      "ANTHROPIC_DEFAULT_HAIKU_MODEL": "uncensored-27b",
      "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "uncensored-27b",
      "ANTHROPIC_DEFAULT_SONNET_MODEL": "uncensored-27b",
      "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "uncensored-27b",
      "ANTHROPIC_DEFAULT_OPUS_MODEL": "uncensored-27b",
      "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "uncensored-27b",
      "ANTHROPIC_DEFAULT_FABLE_MODEL": "uncensored-27b",
      "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "uncensored-27b",
      "CLAUDE_CODE_SUBAGENT_MODEL": "uncensored-27b",
      "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
      "ENABLE_TOOL_SEARCH": "true"
    }
  },
  "codex": {
    "//": "cc-switch Codex provider -> Rust uncensored relay (OpenAI Chat Completions protocol)",
    "config": {
      "model_provider": "uncensored-relay",
      "model": "uncensored-27b"
    },
    "providers": {
      "uncensored-relay": {
        "name": "uncensored-relay",
        "base_url": "http://127.0.0.1:8080/v1",
        "env_key": "UNICENSORED_RELAY_KEY",
        "wire_api": "chat"
      }
    }
  }
}